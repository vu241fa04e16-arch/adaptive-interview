# Adaptive Interview Intelligence - Environment Configuration
PROJECT_NAME="Adaptive Interview Intelligence"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL 18 via asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/adaptive_interview

# Ollama Local Service Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60.0

# Speech-to-Text (STT) Whisper Configuration
# Options: tiny.en, tiny, base.en, base, small.en, small, medium, large-v3
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_SIZE_MB=25

# CORS Allowed Origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
